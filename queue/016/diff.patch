+"""Tests for graphrag_lite.embeddings."""
+
+from __future__ import annotations
+
+import math
+
+import pytest
+
+from graphrag_lite.embeddings import HashEmbedder, cosine_similarity
+
+
+def test_hash_embedder_deterministic():
+    """Same text must produce identical vectors across calls."""
+    emb = HashEmbedder(dim=64)
+    v1 = emb.embed(["hello world"])
+    v2 = emb.embed(["hello world"])
+    assert v1 == v2
+
+
+def test_hash_embedder_different_texts():
+    """Different texts should produce different vectors."""
+    emb = HashEmbedder(dim=64)
+    v1 = emb.embed(["machine learning"])
+    v2 = emb.embed(["knowledge graphs"])
+    assert v1 != v2
+
+
+def test_hash_embedder_output_shape():
+    emb = HashEmbedder(dim=128)
+    vecs = emb.embed(["one", "two", "three"])
+    assert len(vecs) == 3
+    assert all(len(v) == 128 for v in vecs)
+
+
+def test_hash_embedder_l2_normalised():
+    """HashEmbedder output must be L2-normalised (non-zero text)."""
+    emb = HashEmbedder(dim=64)
+    v = emb.embed(["some text here"])[0]
+    norm = math.sqrt(sum(x * x for x in v))
+    assert abs(norm - 1.0) < 1e-6
+
+
+def test_hash_embedder_empty_text_zero_vector():
+    emb = HashEmbedder(dim=32)
+    v = emb.embed([""])[0]
+    assert all(x == 0.0 for x in v)
+
+
+def test_cosine_similarity_identical():
+    emb = HashEmbedder(dim=64)
+    v = emb.embed(["hello world"])[0]
+    sim = cosine_similarity(v, v)
+    assert abs(sim - 1.0) < 1e-6
+
+
+def test_cosine_similarity_different():
+    emb = HashEmbedder(dim=256)
+    v1 = emb.embed(["machine learning artificial intelligence"])[0]
+    v2 = emb.embed(["knowledge graphs neo4j databases"])[0]
+    sim = cosine_similarity(v1, v2)
+    assert sim < 1.0
+
+
+def test_cosine_similarity_zero_vector():
+    v_zero = [0.0] * 32
+    v_other = [1.0] + [0.0] * 31
+    assert cosine_similarity(v_zero, v_other) == 0.0
+
+
+def test_sentence_transformer_embedder():
+    st = pytest.importorskip("sentence_transformers")  # noqa: F841
+    from graphrag_lite.embeddings import SentenceTransformerEmbedder
+
+    emb = SentenceTransformerEmbedder()
+    vecs = emb.embed(["hello world", "another text"])
+    assert len(vecs) == 2
+    assert all(isinstance(v, list) for v in vecs)
+    assert all(len(v) > 0 for v in vecs)
